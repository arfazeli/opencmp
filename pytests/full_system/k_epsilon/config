[MESH]
filename = pytests/mesh_files/coarse_large_square_4bcs.vol

[DIM]
diffuse_interface_method = False

[FINITE ELEMENT SPACE]
elements = u       -> VectorH1
           p       -> H1
           k       -> H1
           epsilon -> H1
interpolant_order = 2

[DG]
DG = False
interior_penalty_coefficient = 10.0

[SOLVER]
linear_solver = default
preconditioner = default
linearization_method = Oseen
nonlinear_solver = default
nonlinear_tolerance = relative -> 1e-6
                      absolute -> 1e-10
nonlinear_max_iterations = 5
relaxation_factors = 1.0, 1.0, 1.0, 1.0

[TRANSIENT]
transient = True
scheme = implicit euler
time_range = 0.0, 0.001
dt = 0.001
dt_range = 1e-12, 0.001
dt_tolerance = relative -> 1e-6
               absolute -> 1e-6

[VISUALIZATION]
save_to_file = False

[ERROR ANALYSIS]
check_error = False

[OTHER]
num_threads = 1
model = KEpsilonINS
run_dir = pytests/full_system/k_epsilon
wall_function = False
